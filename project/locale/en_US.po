# DO NOT TRANSLATE - this is a workaround to allow each language to define how it should be displayed within the game.
#. The native name of the language. This will be presented as an option in the language settings menu.
msgid "locale_language"
msgstr "locale_language"

#. The title of the game, located on the main menu.
msgid "main_game_title"
msgstr ""

#. A button to continue a previously saved game, located on the main menu.
msgid "main_continue"
msgstr "Continue"

#. A "play game" button, located on the main menu.
msgid "main_play"
msgstr "Play"

#. A button to open the options menu, located on the main menu.
msgid "main_options"
msgstr "Options"

#. A button to open the game's recent changes, located on the main menu.
msgid "main_patch_notes"
msgstr "Patch Notes"

#. A button to open the game's credits, located on the main menu.
msgid "main_credits"
msgstr "Credits"

#. A button to quit/exit the game, located on the main menu.
msgid "main_quit"
msgstr "Quit"

#. Displayed to the player on a loading screen and indicates the game is loading.
msgid "loading_in_progress"
msgstr "Loading..."

#. A button label to retry a failed operation.
msgctxt "alert"
msgid "alert_retry"
msgstr "Retry"

#. A button label to continue despite an error.
msgctxt "alert"
msgid "alert_continue"
msgstr "Continue"

#. A button label to return to the main menu.
msgctxt "alert"
msgid "alert_return_to_menu"
msgstr "Return to Menu"

#. A button label to quit the game.
msgctxt "alert"
msgid "alert_quit"
msgstr "Quit"

#. The title of the error dialog shown when a save operation fails.
msgid "error_save_failed_title"
msgstr "Save Failed"

#. The generic message shown when a save operation fails.
msgid "error_save_failed_message"
msgstr "Your game could not be saved."

#. The message shown when a save operation fails due to insufficient storage.
msgid "error_save_failed_storage_message"
msgstr "Your game could not be saved. Please check your available storage."

#. The title of the error dialog shown when loading a save file fails.
msgid "error_load_failed_title"
msgstr "Load Failed"

#. The generic message shown when loading a save file fails.
msgid "error_load_failed_message"
msgstr "This save file could not be loaded."

#. The message shown when loading a save file fails due to possible data corruption.
msgid "error_load_failed_corrupted_message"
msgstr "This save file could not be loaded. It may be damaged."

#. A tab within the game's options menu containing gameplay-related settings.
msgid "options_gameplay"
msgstr "Gameplay"

#. Used as a category name for a group of input actions related to gameplay input.
msgctxt "action_sets"
msgid "Gameplay"
msgstr "In-game actions"

#. Used as a category name for a group of input actions related to gameplay options.
msgctxt "action_sets"
msgid "GameplayOptions"
msgstr "In-game options"

#. An input action that opens the pause menu during gameplay.
msgctxt "actions_GameplayOptions"
msgid "ui_toggle_menu_pause"
msgstr "Pause"

#. An input action that opens the settings menu when the player is on a menu screen.
msgctxt "actions_MenuOptions"
msgid "ui_toggle_menu_settings"
msgstr "Options"


# Godot-specific files
.godot/

# godot-infra build artifacts
# NOTE: A runtime-only symlink created by 'coffeebeats/godot-infra' actions so
# they can self-reference at a pinned hash; it must never be committed.
.godot-infra

# Translation files
*.translation

# MacOS-specific files
.DS_Store

# Windows-specific files
~*
*.TMP

# Godot source/editor files
/.scons
/godot
Godot.app
godot.app
Godot.exe
godot.exe

# Testing-related files
settings.cfg
settings.cfg.bak
settings.dat
settings.dat.bak

# IDE-related files
.vscode/*
!.vscode/tasks.json

# Coding agent-related files
.claude/*
!.claude/hooks
!.claude/settings.json
!.claude/skills

# Engine class reference dumped by the 'godot-api' skill; regenerate with
# '.claude/skills/godot-api/dump_api.sh'.
.godot-api/

# Editor addons vendored locally. Neither is committed, since an editor addon's value
# is a GUI and neither Claude nor CI can drive one.
addons/AsepriteWizard/
addons/gdfxr/

# Throwaway probes; their findings live in tools/README.md.
.probe/
